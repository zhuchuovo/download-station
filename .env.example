# 下载站配置模板：cp .env.example .env 后按需修改
# 也可以完全不管它——用 sudo node server/panel.js 打开面板点「一键开服」，会自动生成 .env

PORT=3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2048
JWT_SECRET=请改成随机长字符串

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=ds_app
PG_PASSWORD=请改成数据库密码
PG_DATABASE=download_station

# 面板访问密码（可选，设置后需密码才能进入面板）
PANEL_PASSWORD=
